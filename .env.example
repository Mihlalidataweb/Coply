# Network Configuration
# Choose which network to deploy to (localhost, sepolia, polygon, arbitrum)
HARDHAT_NETWORK=localhost

# Private Key (for deployment)
# IMPORTANT: Never commit your private key to version control!
# Use a test account or hardware wallet for mainnet deployments
PRIVATE_KEY=your_private_key_here

# RPC URLs
SEPOLIA_URL=https://sepolia.infura.io/v3/your_infura_project_id
POLYGON_URL=https://polygon-mainnet.infura.io/v3/your_infura_project_id
ARBITRUM_URL=https://arb-mainnet.infura.io/v3/your_infura_project_id

# API Keys for Contract Verification
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# IPFS Configuration (Pinata)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key

# Frontend Environment Variables
REACT_APP_PINATA_API_KEY=your_pinata_api_key
REACT_APP_PINATA_SECRET_API_KEY=your_pinata_secret_api_key

# Network RPC URLs for Frontend
REACT_APP_ETHEREUM_RPC=https://mainnet.infura.io/v3/your_infura_project_id
REACT_APP_POLYGON_RPC=https://polygon-mainnet.infura.io/v3/your_infura_project_id
REACT_APP_ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

# Optional: Analytics and Monitoring
REACT_APP_GOOGLE_ANALYTICS_ID=your_ga_id

# Development
NODE_ENV=development